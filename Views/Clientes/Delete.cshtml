@model Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
    bool tienePedidos = Model.Pedidos.Count > 0;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver</a>
    <h1 class="h4 mb-0 text-danger">Eliminar Cliente</h1>
</div>

<div class="card border-danger shadow-sm" style="max-width:550px">
    <div class="card-body">
        <p class="text-danger fw-semibold">¿Confirma que quiere eliminar este cliente?</p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre @Model.ApellidoPaterno</dd>
            <dt class="col-sm-4">Cédula</dt>
            <dd class="col-sm-8">@Model.Cedula</dd>
            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@Model.Correos.FirstOrDefault()?.Correo</dd>
        </dl>

        @if (tienePedidos)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Este cliente tiene <strong>@Model.Pedidos.Count</strong> pedido(s) registrado(s) y no se puede eliminar
            </div>
        }
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Cedula" />
            <button type="submit" class="btn btn-danger btn-sm" disabled="@tienePedidos">Sí, eliminar</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
    </div>
</div>