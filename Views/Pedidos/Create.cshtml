@model PedidoCreateViewModel
@{
    ViewData["Title"] = "Nuevo Pedido";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver</a>
    <h1 class="h4 mb-0">Nuevo Pedido</h1>
</div>

@Html.AntiForgeryToken()

<div id="alertBox" class="alert alert-danger d-none"></div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <label for="clienteSelect" class="form-label">Cliente</label>
                <select id="clienteSelect" class="form-select" asp-items="Model.Clientes">
                    <option value="">Seleccione un cliente</option>
                </select>
                @if (!Model.Clientes.Any())
                {
                    <div class="form-text text-danger">
                        No hay clientes registrados. <a asp-controller="Clientes" asp-action="Create">Crear un cliente</a> antes de generar un pedido.
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <label for="buscadorProducto" class="form-label">Agregar producto</label>
                <div class="position-relative">
                    <input type="text" id="buscadorProducto" class="form-control"
                           placeholder="Buscar producto por nombre..." autocomplete="off" />
                    <div id="sugerencias" class="list-group position-absolute w-100 shadow-sm d-none"
                         style="z-index:1000; max-height:260px; overflow-y:auto;"></div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th style="width:100px">Cant.</th>
                            <th class="text-end">Precio unit.</th>
                            <th style="width:110px">Desc. %</th>
                            <th class="text-center">IVA %</th>
                            <th class="text-end">Total línea</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="carritoBody">
                        <tr id="carritoVacio">
                            <td colspan="7" class="text-center text-muted py-4">Aún no ha agregado productos.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="position:sticky; top:1rem;">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small mb-3">Totales</h6>
                <dl class="row mb-3">
                    <dt class="col-7">Subtotal</dt>
                    <dd class="col-5 text-end" id="totalSubtotal">₡0.00</dd>
                    <dt class="col-7">Descuento</dt>
                    <dd class="col-5 text-end" id="totalDescuento">-₡0.00</dd>
                    <dt class="col-7">Impuesto</dt>
                    <dd class="col-5 text-end" id="totalImpuesto">₡0.00</dd>
                    <dt class="col-7 fw-bold border-top pt-2">Total</dt>
                    <dd class="col-5 text-end fw-bold border-top pt-2" id="totalTotal">₡0.00</dd>
                </dl>
                <button type="button" id="btnConfirmar" class="btn btn-primary w-100" disabled>
                    Confirmar pedido
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const buscador = document.getElementById('buscadorProducto');
            const sugerencias = document.getElementById('sugerencias');
            const carritoBody = document.getElementById('carritoBody');
            const carritoVacio = document.getElementById('carritoVacio');
            const btnConfirmar = document.getElementById('btnConfirmar');
            const clienteSelect = document.getElementById('clienteSelect');
            const alertBox = document.getElementById('alertBox');

            let carrito = []; // { productoId, nombre, precioUnitario, cantidad, descuentoPorc, impuestoPorc, stockDisponible, totalLinea }
            let debounceTimer = null;

            function money(v) {
                return '₡' + Number(v).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function mostrarError(msg) {
                alertBox.textContent = msg;
                alertBox.classList.remove('d-none');
            }
            function ocultarError() {
                alertBox.classList.add('d-none');
            }

      // ── Autosuggest de productos
            buscador.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const q = buscador.value.trim();
                if (q.length === 0) {
                    sugerencias.classList.add('d-none');
                    sugerencias.innerHTML = '';
                    return;
                }
                debounceTimer = setTimeout(() => buscarProductos(q), 250);
            });

            document.addEventListener('click', function (e) {
                if (!sugerencias.contains(e.target) && e.target !== buscador) {
                    sugerencias.classList.add('d-none');
                }
            });

            async function buscarProductos(q) {
                const res = await fetch('/Pedidos/BuscarProductos?q=' + encodeURIComponent(q));
                if (!res.ok) return;
                const productos = await res.json();

                sugerencias.innerHTML = '';
                if (productos.length === 0) {
                    sugerencias.innerHTML = '<div class="list-group-item text-muted small">Sin resultados</div>';
                } else {
                    productos.forEach(p => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                        item.innerHTML = `<span>${p.nombre}</span><span class="text-muted small">${money(p.precio)} · stock ${p.stock}</span>`;
                        item.addEventListener('click', () => {
                            agregarProducto(p);
                            buscador.value = '';
                            sugerencias.classList.add('d-none');
                        });
                        sugerencias.appendChild(item);
                    });
                }
                sugerencias.classList.remove('d-none');
            }

            function agregarProducto(p) {
                const existente = carrito.find(l => l.productoId === p.id);
                if (existente) {
                    existente.cantidad += 1;
                } else {
                    carrito.push({
                        productoId: p.id,
                        nombre: p.nombre,
                        precioUnitario: p.precio,
                        cantidad: 1,
                        descuentoPorc: 0,
                        impuestoPorc: p.impuestoPorc,
                        stockDisponible: p.stock,
                        totalLinea: 0
                    });
                }
                renderCarrito();
                recalcular();
            }

            function quitarProducto(productoId) {
                carrito = carrito.filter(l => l.productoId !== productoId);
                renderCarrito();
                recalcular();
            }

            function renderCarrito() {
                carritoBody.innerHTML = '';
                if (carrito.length === 0) {
                    carritoBody.appendChild(carritoVacio);
                    return;
                }

                carrito.forEach(l => {
                    const tr = document.createElement('tr');
                    if (l.cantidad > l.stockDisponible) tr.classList.add('table-danger');

                    tr.innerHTML = `
                        <td>
                            ${l.nombre}
                            ${l.cantidad > l.stockDisponible ? '<div class="text-danger small">Stock disponible: ' + l.stockDisponible + '</div>' : ''}
                        </td>
                        <td><input type="number" min="1" max="${l.stockDisponible}" class="form-control form-control-sm cantidad-input" value="${l.cantidad}" /></td>
                        <td class="text-end">${money(l.precioUnitario)}</td>
                        <td><input type="number" min="0" max="100" step="0.01" class="form-control form-control-sm descuento-input" value="${l.descuentoPorc}" /></td>
                        <td class="text-center">${l.impuestoPorc}%</td>
                        <td class="text-end fw-semibold linea-total">${money(l.totalLinea)}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-quitar">✕</button>
                        </td>`;

                    tr.querySelector('.cantidad-input').addEventListener('change', (e) => {
                        l.cantidad = Math.max(1, parseInt(e.target.value) || 1);
                        recalcular();
                    });
                    tr.querySelector('.descuento-input').addEventListener('change', (e) => {
                        l.descuentoPorc = Math.min(100, Math.max(0, parseFloat(e.target.value) || 0));
                        recalcular();
                    });
                    tr.querySelector('.btn-quitar').addEventListener('click', () => quitarProducto(l.productoId));

                    carritoBody.appendChild(tr);
                });
            }

            async function recalcular() {
                ocultarError();
                if (carrito.length === 0) {
                    actualizarTotales({ subtotal: 0, descuento: 0, impuesto: 0, total: 0, lineas: [] });
                    return;
                }

                const body = carrito.map(l => ({
                    productoId: l.productoId,
                    cantidad: l.cantidad,
                    descuentoPorc: l.descuentoPorc
                }));

                const res = await fetch('/Pedidos/Calcular', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(body)
                });

                if (!res.ok) {
                    mostrarError('No se pudo calcular el total del pedido.');
                    return;
                }

                const data = await res.json();

          // Sincronizar stock y total de cada linea con lo devuelto por el servidor
                data.lineas.forEach(dl => {
                    const linea = carrito.find(l => l.productoId === dl.productoId);
                    if (linea) {
                        linea.stockDisponible = dl.stockDisponible;
                        linea.totalLinea = dl.totalLinea;
                    }
                });

                renderCarrito();
                actualizarTotales(data);
            }

            function actualizarTotales(data) {
                document.getElementById('totalSubtotal').textContent = money(data.subtotal);
                document.getElementById('totalDescuento').textContent = '-' + money(data.descuento);
                document.getElementById('totalImpuesto').textContent = money(data.impuesto);
                document.getElementById('totalTotal').textContent = money(data.total);

                const hayStockInsuficiente = carrito.some(l => l.cantidad > l.stockDisponible);
                btnConfirmar.disabled = carrito.length === 0 || !clienteSelect.value || hayStockInsuficiente;
            }

            clienteSelect.addEventListener('change', () => actualizarTotales({
                subtotal: parseMoney(document.getElementById('totalSubtotal').textContent),
                descuento: parseMoney(document.getElementById('totalDescuento').textContent),
                impuesto: parseMoney(document.getElementById('totalImpuesto').textContent),
                total: parseMoney(document.getElementById('totalTotal').textContent)
            }));

            function parseMoney(text) {
                return parseFloat(text.replace(/[^\d.-]/g, '')) || 0;
            }

            btnConfirmar.addEventListener('click', async function () {
                ocultarError();
                btnConfirmar.disabled = true;
                btnConfirmar.textContent = 'Guardando....';

                const payload = {
                    clienteId: clienteSelect.value,
                    lineas: carrito.map(l => ({
                        productoId: l.productoId,
                        cantidad: l.cantidad,
                        descuentoPorc: l.descuentoPorc
                    }))
                };

                const res = await fetch('/Pedidos/Confirmar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    const data = await res.json();
                    window.location.href = data.redirectUrl;
                } else {
                    const err = await res.json().catch(() => ({ message: 'No se pudo confirmar el pedido.' }));
                    mostrarError(err.message || 'No se pudo confirmar el pedido');
                    btnConfirmar.disabled = false;
                    btnConfirmar.textContent = 'Confirmar pedido';
                }
            });
        })();
    </script>
}
